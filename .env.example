# مرزوق - Marzouq Voice Agent Configuration
# ملف الإعدادات البيئية - Environment Configuration File

# Flask Configuration
# إعدادات Flask
FLASK_APP=app.py
FLASK_ENV=development
DEBUG=True
PORT=5000

# Twilio Configuration (اختياري - Optional)
# احصل على هذه القيم من لوحة تحكم Twilio - Get these from Twilio Console
# TWILIO_ACCOUNT_SID=your_account_sid_here
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=your_twilio_phone_number

# OpenAI Configuration (اختياري للردود الذكية - Optional for smart responses)
# OPENAI_API_KEY=your_openai_api_key_here

# Application Settings
# إعدادات التطبيق
MAX_SPEECH_TIMEOUT=10
DEFAULT_LANGUAGE=ar-SA
